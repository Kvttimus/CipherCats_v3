# Supabase project settings -> API. Only the PUBLIC anon key goes here; it's
# used for Supabase Auth only. The frontend never queries the database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Flask API base URL. Leave blank in dev (Vite proxies /api to localhost:5000).
# In production: https://<your-render-service>.onrender.com
VITE_API_URL=
